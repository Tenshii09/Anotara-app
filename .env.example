OTP_EXPIRES_MINUTES=5

# Deployed React SPA origin (used for CORS, password-reset links, and emails).
# In production (FLASK_ENV=production), only this origin is allowed unless CORS_ORIGINS is set.
FRONTEND_URL=https://anotara-app.vercel.app

# Optional comma-separated list for extra origins (FRONTEND_URL is always included).
# CORS_ORIGINS=https://anotara-app.vercel.app,http://localhost:5173

# Set to production on AWS so CORS locks to FRONTEND_URL only.
# FLASK_ENV=production
